# Connexion à l'interface : nom d'utilisateur + code PIN à 4 chiffres
ADMIN_USERNAME=admin
ADMIN_PIN=
# Signe les sessions (et sert de clé pour les scripts) — 16 caractères minimum : openssl rand -hex 24
API_KEY=
# Chiffre les identifiants (Gmail…) — 64 caractères hex : openssl rand -hex 32. Ne la perdez pas.
ENCRYPTION_KEY=
# Adresse publique du serveur (webhooks, retour OAuth Google)
PUBLIC_URL=http://localhost:3001
# Origine(s) du frontend autorisée(s), séparées par des virgules
CORS_ORIGIN=http://localhost:3000
PORT=3001
DATA_DIR=./data
# Clé Groq utilisée par défaut par le bloc LLM (console.groq.com/keys)
GROQ_API=
